# Frontapp API credentials
FRONTAPP_API_KEY=your_frontapp_api_key_here

# Dealfront (Leadfeeder) API credentials
# Generate at: https://app.dealfront.com/l/settings/personal/api-tokens
DEALFRONT_API_TOKEN=your_dealfront_api_token_here
# IP Enrich API key (optional) — enables IP-to-company resolution
DEALFRONT_IP_ENRICH_API_KEY=your_ip_enrich_api_key_here

# Instantly.ai API credentials (V2)
# Generate at: Dashboard -> Settings -> Integrations -> API
INSTANTLY_API_KEY=your_instantly_api_key_here

# ── Support-research credentials (role-level endpoints, not org-level) ──

# Heroku Postgres — prod read-only replica
CLAUDE_URL=postgres://readonly_user:password@host:5432/dbname

# Heroku Postgres — sandbox / UAT
CLAUDE_UAT_URL=postgres://readonly_user:password@sandbox-host:5432/dbname

# coadmin-api (Cotribute internal admin API)
# Reuses the same ACQUIRE_API_* creds that coadmin (Rails) uses
DREAMBIGGER_API_BASE_URL=https://coadmin-api.example.com
ACQUIRE_API_KEY=your_acquire_api_key_here
ACQUIRE_API_SECRET=your_acquire_api_secret_here
ACQUIRE_API_CLIENT_ID=your_acquire_api_client_id_here

# Papertrail API token (papertrailapp.com → Profile → API token)
PAPERTRAIL_API_TOKEN=your_papertrail_token_here

# GitHub fine-grained PAT — scopes: Contents (read), Code Search (read)
GITHUB_TOKEN=ghp_your_token_here
# Optional default org for github_search_code when no repo/org provided (default: cotribute)
GITHUB_DEFAULT_ORG=cotribute

# ── AIA (AI Institution Advisor) — internal-only, read-only ──
# One unscoped key ("Switchboard (internal MCP)") that reads every institution.
# Never issue to clients. Rotate on the AIA Developer API page if exposed.
AIA_API_KEY=aia_live_your_key_here
# Optional base URL override (defaults to the AIA Public API v1 endpoint)
AIA_BASE_URL=https://wyjwvznwrxrboxgluktu.supabase.co/functions/v1/api/v1
# Expose the ops/admin tools (freshness, changes, jobs, audit, cost, whoami).
# Off by default to keep the model's tool surface lean; set to "true" for ops use.
AIA_ENABLE_OPS=false

# Webhook configuration
WEBHOOK_SECRET=your_webhook_secret_here
WEBHOOK_BASE_URL=https://your-webhook-url.com

# Server configuration
PORT=3000

# Logging and Monitoring
LOG_LEVEL=info
METRICS_INTERVAL=60000

# API Gateway configuration
API_KEY=your_api_key_here
CORS_ORIGINS=*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Security configuration
# Generate a secure encryption key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_encryption_key_here
CREDENTIALS_DIR=./credentials

# HTTPS configuration (optional)
HTTPS_ENABLED=false
HTTPS_CERT=path/to/cert.pem
HTTPS_KEY=path/to/key.pem

# Rate limiting configuration
RATE_LIMITING_ENABLED=true

# ── Website analytics (GTM team) ──
# Supabase Postgres for the project shared by cotribute/contribute-3.0 (the
# public site) and cotribute/webmaster (the admin portal). Use the session
# pooler (port 5432) and a dedicated read-only role — never the service-role key.
WEBSITE_DB_URL=postgres://claude_readonly:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres
